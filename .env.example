TORQPRO_SECRET_KEY=CHANGE_WITH_A_LONG_RANDOM_SECRET
TORQPRO_ENV=production
TORQPRO_ALLOWED_HOSTS=torqpro.example.com
TORQPRO_DB_PATH=/app/runtime/torqpro.db

# AI-P1: Anthropic Claude provider (optional — disabled by default)
# Set TORQPRO_ANTHROPIC_ENABLED=true to activate.
# TORQPRO_ANTHROPIC_API_KEY must be set via a secrets manager or secure
# environment injection — NEVER commit a real key to source control.
TORQPRO_ANTHROPIC_ENABLED=false
TORQPRO_ANTHROPIC_API_KEY=
TORQPRO_ANTHROPIC_MODEL=claude-sonnet-5
TORQPRO_ANTHROPIC_TIMEOUT_SECONDS=30
TORQPRO_ANTHROPIC_MAX_TOKENS=16000

# AI-P2L: Ollama local provider (free/local, disabled by default)
# Set TORQPRO_OLLAMA_ENABLED=true to activate.
# Requires a running Ollama server: https://ollama.com
# Recommended first model: qwen3:8b  (run: ollama pull qwen3:8b)
# PAID_CLOUD_AUTO_FALLBACK=NO: Ollama failure never silently routes to Anthropic.
TORQPRO_OLLAMA_ENABLED=false
TORQPRO_OLLAMA_BASE_URL=http://127.0.0.1:11434
TORQPRO_OLLAMA_MODEL=qwen3:8b
TORQPRO_OLLAMA_TIMEOUT_SECONDS=120
