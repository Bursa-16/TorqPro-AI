TORQPRO_SECRET_KEY=CHANGE_WITH_A_LONG_RANDOM_SECRET
TORQPRO_ENV=production
TORQPRO_ALLOWED_HOSTS=torqpro.example.com
TORQPRO_DB_PATH=/app/runtime/torqpro.db

# AI-P1: Anthropic Claude provider (optional — disabled by default)
# Set TORQPRO_ANTHROPIC_ENABLED=true to activate.
# TORQPRO_ANTHROPIC_API_KEY must be set via a secrets manager or secure
# environment injection — NEVER commit a real key to source control.
TORQPRO_ANTHROPIC_ENABLED=false
TORQPRO_ANTHROPIC_API_KEY=
TORQPRO_ANTHROPIC_MODEL=claude-sonnet-4-6
TORQPRO_ANTHROPIC_TIMEOUT_SECONDS=30
TORQPRO_ANTHROPIC_MAX_TOKENS=1024
